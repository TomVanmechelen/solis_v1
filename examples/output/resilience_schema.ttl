@prefix dcterm: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix resilience: <http://https://reiresearch.eu/_doc/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

resilience: a owl:Ontology;
  dcterm:title "Resilience data model";
  dcterm:creator "LIBIS";
  dcterm:date "2026-06-30 13:16:35 +0200";
  dcterm:description "Resilience data model";
  owl:versionInfo "2.0" .

resilience:\@context a rdf:Property;
  rdfs:label "@context"@en;
  rdfs:comment ""@en;
  rdfs:domain resilience:Thing;
  rdfs:range "" .

resilience:\@id a rdf:Property;
  rdfs:label "@id"@en;
  rdfs:comment ""@en;
  rdfs:domain resilience:Thing;
  rdfs:range [
    a rdfs:Datatype;
    owl:unionOf (xsd:string xsd:anyURI)
  ] .

resilience:\@type a rdf:Property;
  rdfs:label "@type"@en;
  rdfs:comment ""@en;
  rdfs:domain resilience:Thing;
  rdfs:range [
    a rdfs:Datatype;
    owl:unionOf (xsd:string xsd:anyURI)
  ] .

resilience:\@uuid a rdf:Property;
  rdfs:label "@uuid"@en;
  rdfs:comment ""@en;
  rdfs:domain resilience:Thing;
  rdfs:range xsd:string .

resilience:about a rdf:Property;
  rdfs:label "about"@en;
  rdfs:comment "The subject matter of an object."@en;
  rdfs:domain resilience:CreativeWork,
    resilience:Event;
  rdfs:range <http://schema.org/Thing> .

resilience:actor a rdf:Property;
  rdfs:label "actor"@en;
  rdfs:comment "An actor (individual or a group), e.g. in TV, radio, movie, video games etc., or in an event. Actors can be associated with individual items or with a series, episode, clip."@en;
  rdfs:domain resilience:Event;
  rdfs:range <http://schema.org/Person> .

resilience:additionalProperty a rdf:Property;
  rdfs:label "additionalProperty"@en;
  rdfs:comment "A property-value pair representing an additional characteristic of the entity, e.g. a product feature or another characteristic for which there is no matching property in schema.org.\\n\\nNote: Publishers should be aware that applications designed to use specific schema.org properties (e.g. http://schema.org/width, http://schema.org/color, http://schema.org/gtin13, ...) will typically expect such data to be provided using those properties, rather than using the generic property/value mechanism."@en;
  rdfs:domain resilience:Place;
  rdfs:range <http://schema.org/PropertyValue> .

resilience:additionalType a rdf:Property;
  rdfs:label "additionalType"@en;
  rdfs:comment "An additional type for the item, typically used for adding more specific types from external vocabularies in microdata syntax. This is a relationship between something and a class that the thing is in. Typically the value is a URI-identified RDF class, and in this case corresponds to the    use of rdf:type in RDF. Text values can be used sparingly, for cases where useful information can be added without their being an appropriate schema to reference. In the case of text values, the class label should follow the schema.org <a href=\"http://schema.org/docs/styleguide.html\">style guide</a>."@en;
  rdfs:domain resilience:Thing;
  rdfs:range [
    a rdfs:Datatype;
    owl:unionOf (xsd:string xsd:anyURI)
  ] .

resilience:address a rdf:Property;
  rdfs:label "address"@en;
  rdfs:comment "Physical address of the item."@en;
  rdfs:domain resilience:Organization,
    resilience:Person,
    resilience:Place;
  rdfs:range xsd:string .

resilience:alternateName a rdf:Property;
  rdfs:label "alternateName"@en;
  rdfs:comment "An alias for the item."@en;
  rdfs:domain resilience:Thing;
  rdfs:range xsd:string .

resilience:alumniOf a rdf:Property;
  rdfs:label "alumniOf"@en;
  rdfs:comment "An organization that the person is an alumni of."@en;
  rdfs:domain resilience:Person;
  rdfs:range <http://schema.org/Organization> .

resilience:articleBody a rdf:Property;
  rdfs:label "articleBody"@en;
  rdfs:comment "The actual body of the article."@en;
  rdfs:domain resilience:Article;
  rdfs:range xsd:string .

resilience:articleSection a rdf:Property;
  rdfs:label "articleSection"@en;
  rdfs:comment "Articles may belong to one or more 'sections' in a magazine or newspaper, such as Sports, Lifestyle, etc."@en;
  rdfs:domain resilience:Article;
  rdfs:range xsd:string .

resilience:associatedMedia a rdf:Property;
  rdfs:label "associatedMedia"@en;
  rdfs:comment "A media object that encodes this CreativeWork. This property is a synonym for encoding."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range <http://schema.org/MediaObject> .

resilience:author a rdf:Property;
  rdfs:label "author"@en;
  rdfs:comment "The author of this content or rating. Please note that author is special in that HTML 5 provides a special mechanism for indicating authorship via the rel tag. That is equivalent to this and may be used interchangeably."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range resilience:U-6b5d000d845bf0ae .

resilience:birthDate a rdf:Property;
  rdfs:label "birthDate"@en;
  rdfs:comment "Date of birth."@en;
  rdfs:domain resilience:Person;
  rdfs:range xsd:date .

resilience:birthPlace a rdf:Property;
  rdfs:label "birthPlace"@en;
  rdfs:comment "The place where the person was born."@en;
  rdfs:domain resilience:Person;
  rdfs:range <http://schema.org/Place> .

resilience:bookEdition a rdf:Property;
  rdfs:label "bookEdition"@en;
  rdfs:comment "The edition of the book."@en;
  rdfs:domain resilience:Book;
  rdfs:range xsd:string .

resilience:citation a rdf:Property;
  rdfs:label "citation"@en;
  rdfs:comment "A citation or reference to another creative work, such as another publication, web page, scholarly article, etc."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range <http://schema.org/CreativeWork> .

resilience:color a rdf:Property;
  rdfs:label "color"@en;
  rdfs:comment "The color of the thing."@en;
  rdfs:domain resilience:Thing;
  rdfs:range xsd:string .

resilience:comment a rdf:Property;
  rdfs:label "comment"@en;
  rdfs:comment "Comments, typically from users."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range <http://schema.org/Comment> .

resilience:contentLocation a rdf:Property;
  rdfs:label "contentLocation"@en;
  rdfs:comment "The location depicted or described in the content. For example, the location in a photograph or painting."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range <http://schema.org/Place> .

resilience:contentUrl a rdf:Property;
  rdfs:label "contentUrl"@en;
  rdfs:comment "Actual bytes of the media object, for example the image file or video file."@en;
  rdfs:domain resilience:MediaObject;
  rdfs:range xsd:anyURI .

resilience:contributor a rdf:Property;
  rdfs:label "contributor"@en;
  rdfs:comment "A secondary contributor to the CreativeWork or Event."@en;
  rdfs:domain resilience:CreativeWork,
    resilience:Event;
  rdfs:range resilience:U-6b5d000d845bf0ae .

resilience:copyrightNotice a rdf:Property;
  rdfs:label "copyrightNotice"@en;
  rdfs:comment "Text of a notice appropriate for describing the copyright aspects of this Creative Work, ideally indicating the owner of the copyright for the Work."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range xsd:string .

resilience:creativeWorkStatus a rdf:Property;
  rdfs:label "creativeWorkStatus"@en;
  rdfs:comment "The status of a creative work in terms of its stage in a lifecycle. Example terms include Incomplete, Draft, Published, Obsolete. Some organizations define a set of terms for the stages of their publication lifecycle."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range xsd:string .

resilience:creator a rdf:Property;
  rdfs:label "creator"@en;
  rdfs:comment "The creator/author of this CreativeWork. This is the same as the Author property for CreativeWork."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range resilience:U-6b5d000d845bf0ae .

resilience:dateCreated a rdf:Property;
  rdfs:label "dateCreated"@en;
  rdfs:comment "The date on which the CreativeWork was created or the item was added to a DataFeed."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range [
    a rdfs:Datatype;
    owl:unionOf (xsd:date xsd:dateTime)
  ] .

resilience:dateCreated_time_frame_from a rdf:Property;
  rdfs:label "dateCreated_time_frame_from"@en;
  rdfs:comment "ElasticSearch search and aggregation field based on schema:dataCreated."@en;
  rdfs:domain resilience:Thing;
  rdfs:range xsd:date .

resilience:dateCreated_time_frame_till a rdf:Property;
  rdfs:label "dateCreated_time_frame_till"@en;
  rdfs:comment "ElasticSearch search and aggregation field based on schema:dataCreated."@en;
  rdfs:domain resilience:Thing;
  rdfs:range xsd:date .

resilience:dateModified a rdf:Property;
  rdfs:label "dateModified"@en;
  rdfs:comment "The date on which the CreativeWork was most recently modified or when the item's entry was modified within a DataFeed."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range [
    a rdfs:Datatype;
    owl:unionOf (xsd:date xsd:dateTime)
  ] .

resilience:datePublished a rdf:Property;
  rdfs:label "datePublished"@en;
  rdfs:comment "Date of first publication or broadcast. For example the date a [[CreativeWork]] was broadcast or a [[Certification]] was issued."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range [
    a rdfs:Datatype;
    owl:unionOf (xsd:date xsd:dateTime)
  ] .

resilience:deathDate a rdf:Property;
  rdfs:label "deathDate"@en;
  rdfs:comment "Date of death."@en;
  rdfs:domain resilience:Person;
  rdfs:range xsd:date .

resilience:deathPlace a rdf:Property;
  rdfs:label "deathPlace"@en;
  rdfs:comment "The place where the person died."@en;
  rdfs:domain resilience:Person;
  rdfs:range <http://schema.org/Place> .

resilience:description a rdf:Property;
  rdfs:label "description"@en;
  rdfs:comment "A description of the item."@en;
  rdfs:domain resilience:Thing;
  rdfs:range xsd:string .

resilience:director a rdf:Property;
  rdfs:label "director"@en;
  rdfs:comment "A director of e.g. TV, radio, movie, video gaming etc. content, or of an event. Directors can be associated with individual items or with a series, episode, clip."@en;
  rdfs:domain resilience:Event;
  rdfs:range <http://schema.org/Person> .

resilience:duration a rdf:Property;
  rdfs:label "duration"@en;
  rdfs:comment "The duration of the item (movie, audio recording, event, etc.) in [ISO 8601 duration format](http://en.wikipedia.org/wiki/ISO_8601)."@en;
  rdfs:domain resilience:Event,
    resilience:MediaObject;
  rdfs:range xsd:duration .

resilience:editor a rdf:Property;
  rdfs:label "editor"@en;
  rdfs:comment "Specifies the Person who edited the CreativeWork."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range <http://schema.org/Person> .

resilience:embedUrl a rdf:Property;
  rdfs:label "embedUrl"@en;
  rdfs:comment "A URL pointing to a player for a specific video. In general, this is the information in the ```src``` element of an ```embed``` tag and should not be the same as the content of the ```loc``` tag."@en;
  rdfs:domain resilience:MediaObject;
  rdfs:range xsd:anyURI .

resilience:encodingFormat a rdf:Property;
  rdfs:label "encodingFormat"@en;
  rdfs:comment "Media type typically expressed using a MIME format (see [IANA site](http://www.iana.org/assignments/media-types/media-types.xhtml) and [MDN reference](https://developer.mozilla.org/en-US/docs/Web/HTTP/Basics_of_HTTP/MIME_types)), e.g. application/zip for a SoftwareApplication binary, audio/mpeg for .mp3 etc.In cases where a [[CreativeWork]] has several media type representations, [[encoding]] can be used to indicate each [[MediaObject]] alongside particular [[encodingFormat]] information.Unregistered or niche encoding and file formats can be indicated instead via the most appropriate URL, e.g. defining Web page or a Wikipedia/Wikidata entry."@en;
  rdfs:domain resilience:CreativeWork,
    resilience:MediaObject;
  rdfs:range [
    a rdfs:Datatype;
    owl:unionOf (xsd:string xsd:anyURI)
  ] .

resilience:endDate a rdf:Property;
  rdfs:label "endDate"@en;
  rdfs:comment "The end date and time of the item (in [ISO 8601 date format](http://en.wikipedia.org/wiki/ISO_8601))."@en;
  rdfs:domain resilience:Event,
    resilience:Role;
  rdfs:range [
    a rdfs:Datatype;
    owl:unionOf (xsd:date xsd:dateTime)
  ] .

resilience:endTime a rdf:Property;
  rdfs:label "endTime"@en;
  rdfs:comment "The endTime of something. For a reserved event or service (e.g. FoodEstablishmentReservation), the time that it is expected to end. For actions that span a period of time, when the action was performed. E.g. John wrote a book from January to *December*. For media, including audio and video, it's the time offset of the end of a clip within a larger file.\\n\\nNote that Event uses startDate/endDate instead of startTime/endTime, even when describing dates with times. This situation may be clarified in future revisions."@en;
  rdfs:domain resilience:MediaObject;
  rdfs:range xsd:dateTime .

resilience:familyName a rdf:Property;
  rdfs:label "familyName"@en;
  rdfs:comment "Family name. In the U.S., the last name of a Person."@en;
  rdfs:domain resilience:Person;
  rdfs:range xsd:string .

resilience:givenName a rdf:Property;
  rdfs:label "givenName"@en;
  rdfs:comment "Given name. In the U.S., the first name of a Person."@en;
  rdfs:domain resilience:Person;
  rdfs:range xsd:string .

resilience:hasOccupation a rdf:Property;
  rdfs:label "hasOccupation"@en;
  rdfs:comment "The Person's occupation. For past professions, use Role for expressing dates."@en;
  rdfs:domain resilience:Person;
  rdfs:range <http://schema.org/Occupation> .

resilience:headline a rdf:Property;
  rdfs:label "headline"@en;
  rdfs:comment "Headline of the article."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range xsd:string .

resilience:height a rdf:Property;
  rdfs:label "height"@en;
  rdfs:comment "The height of the item."@en;
  rdfs:domain resilience:MediaObject,
    resilience:Person;
  rdfs:range xsd:float .

resilience:honorificPrefix a rdf:Property;
  rdfs:label "honorificPrefix"@en;
  rdfs:comment "An honorific prefix preceding a Person's name such as Dr/Mrs/Mr."@en;
  rdfs:domain resilience:Person;
  rdfs:range xsd:string .

resilience:id a rdf:Property;
  rdfs:label "id"@en;
  rdfs:comment "systeem UUID"@en;
  rdfs:domain resilience:Language,
    resilience:Intangible,
    resilience:StructuredValue;
  rdfs:range xsd:string .

resilience:identifier a rdf:Property;
  rdfs:label "identifier"@en;
  rdfs:comment "The identifier property represents any kind of identifier for any kind of [[Thing]], such as ISBNs, GTIN codes, UUIDs etc. Schema.org provides dedicated properties for representing many of these, either as textual strings or as URL (URI) links. See [background notes](/docs/datamodel.html#identifierBg) for more details."@en;
  rdfs:domain resilience:Thing;
  rdfs:range <http://schema.org/PropertyValue> .

resilience:inLanguage a rdf:Property;
  rdfs:label "inLanguage"@en;
  rdfs:comment "The language of the content or performance or used in an action. Please use one of the language codes from the [IETF BCP 47 standard](http://tools.ietf.org/html/bcp47). See also [[availableLanguage]]."@en;
  rdfs:domain resilience:CreativeWork,
    resilience:Event;
  rdfs:range <http://schema.org/Language> .

resilience:interactionStatistic a rdf:Property;
  rdfs:label "interactionStatistic"@en;
  rdfs:comment "The number of interactions for the CreativeWork using the WebSite or SoftwareApplication. The most specific child type of InteractionCounter should be used."@en;
  rdfs:domain resilience:CreativeWork,
    resilience:Organization,
    resilience:Person;
  rdfs:range <http://schema.org/InteractionCounter> .

resilience:isBasedOn a rdf:Property;
  rdfs:label "isBasedOn"@en;
  rdfs:comment "A resource from which this work is derived or from which it is a modification or adaptation."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range <http://schema.org/CreativeWork> .

resilience:isPartOf a rdf:Property;
  rdfs:label "isPartOf"@en;
  rdfs:comment "Indicates an item or CreativeWork that this item, or CreativeWork (in some sense), is part of."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range <http://schema.org/CreativeWork> .

resilience:isbn a rdf:Property;
  rdfs:label "isbn"@en;
  rdfs:comment "The ISBN of the book."@en;
  rdfs:domain resilience:Book;
  rdfs:range xsd:string .

resilience:issn a rdf:Property;
  rdfs:label "issn"@en;
  rdfs:comment "The International Standard Serial Number (ISSN) that identifies this serial publication. You can repeat this property to identify different formats of, or the linking ISSN (ISSN-L) for, this serial publication."@en;
  rdfs:domain resilience:Dataset;
  rdfs:range xsd:string .

resilience:keywords a rdf:Property;
  rdfs:label "keywords"@en;
  rdfs:comment "Keywords or tags used to describe some item. Multiple textual entries in a keywords list are typically delimited by commas, or by repeating the property."@en;
  rdfs:domain resilience:CreativeWork,
    resilience:Event,
    resilience:Organization,
    resilience:Place;
  rdfs:range [
    a rdfs:Datatype;
    owl:unionOf (xsd:string xsd:anyURI)
  ] .

resilience:license a rdf:Property;
  rdfs:label "license"@en;
  rdfs:comment "A license document that applies to this content, typically indicated by URL."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range xsd:anyURI .

resilience:location a rdf:Property;
  rdfs:label "location"@en;
  rdfs:comment "The location of, for example, where an event is happening, where an organization is located, or where an action takes place."@en;
  rdfs:domain resilience:Event,
    resilience:Organization;
  rdfs:range <http://schema.org/Place> .

resilience:locationCreated a rdf:Property;
  rdfs:label "locationCreated"@en;
  rdfs:comment "The location where the CreativeWork was created, which may not be the same as the location depicted in the CreativeWork."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range <http://schema.org/Place> .

resilience:logo a rdf:Property;
  rdfs:label "logo"@en;
  rdfs:comment "An associated logo."@en;
  rdfs:domain resilience:Organization,
    resilience:Place;
  rdfs:range xsd:anyURI .

resilience:mainEntityOfPage a rdf:Property;
  rdfs:label "mainEntityOfPage"@en;
  rdfs:comment "Indicates a page (or other CreativeWork) for which this thing is the main entity being described. See [background notes](/docs/datamodel.html#mainEntityBackground) for details."@en;
  rdfs:domain resilience:Thing;
  rdfs:range xsd:anyURI .

resilience:memberOf a rdf:Property;
  rdfs:label "memberOf"@en;
  rdfs:comment "An Organization (or ProgramMembership) to which this Person or Organization belongs."@en;
  rdfs:domain resilience:Organization,
    resilience:Person;
  rdfs:range <http://schema.org/Organization> .

resilience:mentions a rdf:Property;
  rdfs:label "mentions"@en;
  rdfs:comment "Indicates that the CreativeWork contains a reference to, but is not necessarily about a concept."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range <http://schema.org/Thing> .

resilience:name a rdf:Property;
  rdfs:label "name"@en;
  rdfs:comment "The name of the item."@en;
  rdfs:domain resilience:Thing;
  rdfs:range xsd:string .

resilience:numberOfPages a rdf:Property;
  rdfs:label "numberOfPages"@en;
  rdfs:comment "The number of pages in the book."@en;
  rdfs:domain resilience:Book;
  rdfs:range xsd:integer .

resilience:pageEnd a rdf:Property;
  rdfs:label "pageEnd"@en;
  rdfs:comment "The page on which the work ends; for example \"138\" or \"xvi\"."@en;
  rdfs:domain resilience:Article,
    resilience:PublicationIssue,
    resilience:PublicationVolume;
  rdfs:range [
    a rdfs:Datatype;
    owl:unionOf (xsd:integer xsd:string)
  ] .

resilience:pageStart a rdf:Property;
  rdfs:label "pageStart"@en;
  rdfs:comment "The page on which the work starts; for example \"135\" or \"xiii\"."@en;
  rdfs:domain resilience:Article,
    resilience:PublicationIssue,
    resilience:PublicationVolume;
  rdfs:range [
    a rdfs:Datatype;
    owl:unionOf (xsd:integer xsd:string)
  ] .

resilience:pagination a rdf:Property;
  rdfs:label "pagination"@en;
  rdfs:comment "Any description of pages that is not separated into pageStart and pageEnd; for example, \"1-6, 9, 55\" or \"10-12, 46-49\"."@en;
  rdfs:domain resilience:Article,
    resilience:PublicationIssue,
    resilience:PublicationVolume;
  rdfs:range xsd:string .

resilience:parent a rdf:Property;
  rdfs:label "parent"@en;
  rdfs:comment "A parent of this person."@en;
  rdfs:domain resilience:Person;
  rdfs:range <http://schema.org/Person> .

resilience:producer a rdf:Property;
  rdfs:label "producer"@en;
  rdfs:comment "The person or organization who produced the work (e.g. music album, movie, TV/radio series etc.)."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range resilience:U-6b5d000d845bf0ae .

resilience:productionCompany a rdf:Property;
  rdfs:label "productionCompany"@en;
  rdfs:comment "The production company or studio responsible for the item, e.g. series, video game, episode etc."@en;
  rdfs:domain resilience:MediaObject;
  rdfs:range <http://schema.org/Organization> .

resilience:provider a rdf:Property;
  rdfs:label "provider"@en;
  rdfs:comment "The service provider, service operator, or service performer; the goods producer. Another party (a seller) may offer those services or goods on behalf of the provider. A provider may also serve as the seller."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range resilience:U-6b5d000d845bf0ae .

resilience:publisher a rdf:Property;
  rdfs:label "publisher"@en;
  rdfs:comment "The publisher of the article in question."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range resilience:U-6b5d000d845bf0ae .

resilience:relatedTo a rdf:Property;
  rdfs:label "relatedTo"@en;
  rdfs:comment "The most generic familial relation."@en;
  rdfs:domain resilience:Person;
  rdfs:range <http://schema.org/Person> .

resilience:review a rdf:Property;
  rdfs:label "review"@en;
  rdfs:comment "A review of the item."@en;
  rdfs:domain resilience:CreativeWork,
    resilience:Event,
    resilience:Organization,
    resilience:Place;
  rdfs:range <http://schema.org/Review> .

resilience:roleName a rdf:Property;
  rdfs:label "roleName"@en;
  rdfs:comment "A role played, performed or filled by a person or organization. For example, the team of creators for a comic book might fill the roles named 'inker', 'penciller', and 'letterer'; or an athlete in a SportsTeam might play in the position named 'Quarterback'."@en;
  rdfs:domain resilience:Role;
  rdfs:range [
    a rdfs:Datatype;
    owl:unionOf (xsd:string xsd:anyURI)
  ] .

resilience:sameAs a rdf:Property;
  rdfs:label "sameAs"@en;
  rdfs:comment "URL of a reference Web page that unambiguously indicates the item's identity. E.g. the URL of the item's Wikipedia page, Wikidata entry, or official website."@en;
  rdfs:domain resilience:Thing;
  rdfs:range xsd:anyURI .

resilience:sdDatePublished a rdf:Property;
  rdfs:label "sdDatePublished"@en;
  rdfs:comment "Indicates the date on which the current structured data was generated / published. Typically used alongside [[sdPublisher]]."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range xsd:date .

resilience:sdLicense a rdf:Property;
  rdfs:label "sdLicense"@en;
  rdfs:comment "A license document that applies to this structured data, typically indicated by URL."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range xsd:anyURI .

resilience:sdPublisher a rdf:Property;
  rdfs:label "sdPublisher"@en;
  rdfs:comment "Indicates the party responsible for generating and publishing the current structured data markup, typically in cases where the structured data is derived automatically from existing published content but published on a different site. For example, student projects and open data initiatives often re-publish existing content with more explicitly structured metadata. The[[sdPublisher]] property helps make such practices more explicit."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range resilience:U-6b5d000d845bf0ae .

resilience:startDate a rdf:Property;
  rdfs:label "startDate"@en;
  rdfs:comment "The start date and time of the item (in [ISO 8601 date format](http://en.wikipedia.org/wiki/ISO_8601))."@en;
  rdfs:domain resilience:Event,
    resilience:Role;
  rdfs:range [
    a rdfs:Datatype;
    owl:unionOf (xsd:date xsd:dateTime)
  ] .

resilience:startTime a rdf:Property;
  rdfs:label "startTime"@en;
  rdfs:comment "The startTime of something. For a reserved event or service (e.g. FoodEstablishmentReservation), the time that it is expected to start. For actions that span a period of time, when the action was performed. E.g. John wrote a book from *January* to December. For media, including audio and video, it's the time offset of the start of a clip within a larger file.\\n\\nNote that Event uses startDate/endDate instead of startTime/endTime, even when describing dates with times. This situation may be clarified in future revisions."@en;
  rdfs:domain resilience:MediaObject;
  rdfs:range xsd:dateTime .

resilience:subjectOf a rdf:Property;
  rdfs:label "subjectOf"@en;
  rdfs:comment "A CreativeWork or Event about this Thing."@en;
  rdfs:domain resilience:Thing;
  rdfs:range resilience:U-7592cb0d1c97284f .

resilience:temporalCoverage a rdf:Property;
  rdfs:label "temporalCoverage"@en;
  rdfs:comment "The temporalCoverage of a CreativeWork indicates the period that the content applies to, i.e. that it describes, either as a DateTime or as a textual string indicating a time period in [ISO 8601 time interval format](https://en.wikipedia.org/wiki/ISO_8601#Time_intervals). In      the case of a Dataset it will typically indicate the relevant time period in a precise notation (e.g. for a 2011 census dataset, the year 2011 would be written \"2011/2012\"). Other forms of content, e.g. ScholarlyArticle, Book, TVSeries or TVEpisode, may indicate their temporalCoverage in broader terms - textually or via well-known URL.      Written works such as books may sometimes have precise temporal coverage too, e.g. a work set in 1939 - 1945 can be indicated in ISO 8601 interval format format via \"1939/1945\".Open-ended date ranges can be written with \"..\" in place of the end date. For example, \"2015-11/..\" indicates a range beginning in November 2015 and with no specified final date. This is tentative and might be updated in future when ISO 8601 is officially updated."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range [
    a rdfs:Datatype;
    owl:unionOf (xsd:dateTime xsd:string xsd:anyURI)
  ] .

resilience:text a rdf:Property;
  rdfs:label "text"@en;
  rdfs:comment "The textual content of this CreativeWork."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range xsd:string .

resilience:thumbnailUrl a rdf:Property;
  rdfs:label "thumbnailUrl"@en;
  rdfs:comment "A thumbnail image relevant to the Thing."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range xsd:anyURI .

resilience:url a rdf:Property;
  rdfs:label "url"@en;
  rdfs:comment "URL of the item."@en;
  rdfs:domain resilience:Thing;
  rdfs:range xsd:anyURI .

resilience:value a rdf:Property;
  rdfs:label "value"@en;
  rdfs:comment "The value of a [[QuantitativeValue]] (including [[Observation]]) or property value node.\\n\\n* For [[QuantitativeValue]] and [[MonetaryAmount]], the recommended type for values is 'Number'.\\n* For [[PropertyValue]], it can be 'Text', 'Number', 'Boolean', or 'StructuredValue'.\\n* Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similar Unicode symbols.\\n* Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator."@en;
  rdfs:domain resilience:PropertyValue;
  rdfs:range xsd:string .

resilience:version a rdf:Property;
  rdfs:label "version"@en;
  rdfs:comment "The version of the CreativeWork embodied by a specified resource."@en;
  rdfs:domain resilience:CreativeWork;
  rdfs:range xsd:string .

resilience:volumeNumber a rdf:Property;
  rdfs:label "volumeNumber"@en;
  rdfs:comment "Identifies the volume of publication or multi-part work; for example, \"iii\" or \"2\"."@en;
  rdfs:domain resilience:PublicationVolume;
  rdfs:range [
    a rdfs:Datatype;
    owl:unionOf (xsd:integer xsd:string)
  ] .

resilience:width a rdf:Property;
  rdfs:label "width"@en;
  rdfs:comment "The width of the item."@en;
  rdfs:domain resilience:MediaObject;
  rdfs:range xsd:float .

resilience:wordCount a rdf:Property;
  rdfs:label "wordCount"@en;
  rdfs:comment "The number of words in the text of the CreativeWork such as an Article, Book, etc."@en;
  rdfs:domain resilience:Article,
    resilience:CreativeWork;
  rdfs:range xsd:integer .

<http://schema.org/Article> a owl:Class;
  owl:equivalentClass resilience:Article .

<http://schema.org/Book> a owl:Class;
  owl:equivalentClass resilience:Book .

<http://schema.org/Dataset> a owl:Class;
  owl:equivalentClass resilience:Dataset .

<http://schema.org/Intangible> a owl:Class;
  owl:equivalentClass resilience:Intangible .

<http://schema.org/PublicationIssue> a owl:Class;
  owl:equivalentClass resilience:PublicationIssue .

<http://schema.org/PublicationVolume> a owl:Class;
  owl:equivalentClass resilience:PublicationVolume .

<http://schema.org/Role> a owl:Class;
  owl:equivalentClass resilience:Role .

<http://schema.org/StructuredValue> a owl:Class;
  owl:equivalentClass resilience:StructuredValue .

<http://www.w3.org/ns/prov#wasAssociateFor> a rdfs:property;
  rdfs:label "prov:wasAssociateFor"@en;
  rdfs:comment "reverse of prov:wasAssociatedWith. An prov:Agent that had some (unspecified) responsibility for the occurrence of this prov:Activity."@en;
  rdfs:domain resilience:Thing;
  rdfs:range <http://www.w3.org/ns/prov#Activity> .

resilience:U-7592cb0d1c97284f a owl:Class;
  rdfs:label "schema:CreativeWork OR schema:Event";
  owl:unionOf (<http://schema.org/CreativeWork> <http://schema.org/Event>) .

<http://schema.org/Event> a owl:Class;
  owl:equivalentClass resilience:Event .

<http://schema.org/Language> a owl:Class;
  owl:equivalentClass resilience:Language .

<http://schema.org/MediaObject> a owl:Class;
  owl:equivalentClass resilience:MediaObject .

resilience:Dataset a owl:Class;
  rdfs:label "Dataset";
  rdfs:comment "A body of structured information describing some topic(s) of interest.";
  rdfs:subClassOf <schema:CreativeWork> .

resilience:Intangible a owl:Class;
  rdfs:label "Intangible";
  rdfs:comment "A utility class that serves as the umbrella for a number of 'intangible' things such as quantities, structured values, etc.";
  rdfs:subClassOf <schema:Thing> .

resilience:Language a owl:Class;
  rdfs:label "Language";
  rdfs:comment "Natural languages such as Spanish, Tamil, Hindi, English, etc. Formal language code tags expressed in [BCP 47](https://en.wikipedia.org/wiki/IETF_language_tag) can be used via the [[alternateName]] property. The Language type previously also covered programming languages such as Scheme and Lisp, which are now best represented using [[ComputerLanguage]].";
  rdfs:subClassOf <schema:Intangible> .

resilience:PropertyValue a owl:Class;
  rdfs:label "PropertyValue";
  rdfs:comment "A property-value pair, e.g. representing a feature of a product or place. Use the 'name' property for the name of the property. If there is an additional human-readable version of the value, put that into the 'description' property.\\n\\n Always use specific schema.org properties when a) they exist and b) you can populate them. Using PropertyValue as a substitute will typically not trigger the same effect as using the original, specific property.";
  rdfs:subClassOf <schema:StructuredValue> .

resilience:StructuredValue a owl:Class;
  rdfs:label "StructuredValue";
  rdfs:comment "Structured values are used when the value of a property has a more complex structure than simply being a textual value or a reference to another thing.";
  rdfs:subClassOf <schema:Intangible> .

<http://schema.org/PropertyValue> a owl:Class;
  owl:equivalentClass resilience:PropertyValue .

<http://schema.org/Thing> a owl:Class;
  owl:equivalentClass resilience:Thing .

resilience:Book a owl:Class;
  rdfs:label "Book";
  rdfs:comment "A book.";
  rdfs:subClassOf <schema:CreativeWork> .

resilience:PublicationIssue a owl:Class;
  rdfs:label "PublicationIssue";
  rdfs:comment "A part of a successively published publication such as a periodical or publication volume, often numbered, usually containing a grouping of works such as articles.\\n\\nSee also [blog post](https://blog-schema.org/2014/09/02/schema-org-support-for-bibliographic-relationships-and-periodicals/).";
  rdfs:subClassOf <schema:CreativeWork> .

resilience:Role a owl:Class;
  rdfs:label "Role";
  rdfs:comment "Represents additional information about a relationship or property. For example a Role can be used to say that a 'member' role linking some SportsTeam to a player occurred during a particular time period. Or that a Person's 'actor' role in a Movie was for some particular characterName. Such properties can be attached to a Role entity, which is then associated with the main entities using ordinary properties like 'member' or 'actor'.\\n\\nSee also [blog post](https://blog.schema.org/2014/06/16/introducing-role/).";
  rdfs:subClassOf <schema:Intangible> .

<http://schema.org/CreativeWork> a owl:Class;
  owl:equivalentClass resilience:CreativeWork .

<http://schema.org/Organization> a owl:Class;
  owl:equivalentClass resilience:Organization .

resilience:PublicationVolume a owl:Class;
  rdfs:label "PublicationVolume";
  rdfs:comment "A part of a successively published publication such as a periodical or multi-volume work, often numbered. It may represent a time span, such as a year.\\n\\nSee also [blog post](https://blog-schema.org/2014/09/02/schema-org-support-for-bibliographic-relationships-and-periodicals/).";
  rdfs:subClassOf <schema:CreativeWork> .

<http://schema.org/Place> a owl:Class;
  owl:equivalentClass resilience:Place .

resilience:Place a owl:Class;
  rdfs:label "Place";
  rdfs:comment "Entities that have a somewhat fixed, physical extension.";
  rdfs:subClassOf <schema:Thing> .

<http://schema.org/Person> a owl:Class;
  owl:equivalentClass resilience:Person .

resilience:Article a owl:Class;
  rdfs:label "Article";
  rdfs:comment "An article, such as a news article or piece of investigative report. Newspapers and magazines have articles of many different types and this is intended to cover them all.\\n\\nSee also [blog post](https://blog.schema.org/2014/09/02/schema-org-support-for-bibliographic-relationships-and-periodicals/).";
  rdfs:subClassOf <schema:CreativeWork> .

resilience:U-6b5d000d845bf0ae a owl:Class;
  rdfs:label "schema:Organization OR schema:Person";
  owl:unionOf (<http://schema.org/Organization> <http://schema.org/Person>) .

resilience:Organization a owl:Class;
  rdfs:label "Organization";
  rdfs:comment "An organization such as a school, NGO, corporation, club, etc.";
  rdfs:subClassOf <schema:Thing> .

resilience:MediaObject a owl:Class;
  rdfs:label "MediaObject";
  rdfs:comment "A media object, such as an image, video, audio, or text object embedded in a web page or a downloadable dataset i.e. DataDownload. Note that a creative work may have many media objects associated with it on the same web page. For example, a page about a single song (MusicRecording) may have a music video (VideoObject), and a high and low bandwidth audio stream (2 AudioObject's).";
  rdfs:subClassOf <schema:CreativeWork> .

resilience:Event a owl:Class;
  rdfs:label "Event";
  rdfs:comment "An event happening at a certain time and location, such as a concert, lecture, or festival. Ticketing information may be added via the [[offers]] property. Repeated events may be structured as separate Event objects.";
  rdfs:subClassOf <schema:Thing> .

resilience:Person a owl:Class;
  rdfs:label "Person";
  rdfs:comment "A person (alive, dead, undead, or fictional).";
  rdfs:subClassOf <schema:Thing> .

resilience:Thing a owl:Class;
  rdfs:label "Thing";
  rdfs:comment "The most generic type of item." .

resilience:CreativeWork a owl:Class;
  rdfs:label "CreativeWork";
  rdfs:comment "The most generic kind of creative work, including books, movies, photographs, software programs, etc.";
  rdfs:subClassOf <schema:Thing> .

